##### T11. Atomicity with SAVEPOINT: a bad step is undone, the good step is kept
BEGIN;
BEGIN
CALL sp_record_purchase(12, 5, 20);
CALL
SAVEPOINT before_bad;
SAVEPOINT
INSERT INTO price_quote(part_id, supplier_id, unit_price) SELECT part_id, 1, -5 FROM placement WHERE board_id = 1 AND ref_designator = 'R1';
psql:sql/05_transactions_demo.sql:64: ERROR:  new row for relation "price_quote" violates check constraint "price_quote_unit_price_check"
ROLLBACK TO SAVEPOINT before_bad;
ROLLBACK
COMMIT;
COMMIT
